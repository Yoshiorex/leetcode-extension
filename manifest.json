{
  "manifest_version": 3,
  "name": "LeetCode Click Cooldown",
  "version": "1.0.0",
  "description": "Prevents repeated Run or Submit clicks during a short cooldown.",
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*", "https://www.leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "leetcode-click-cooldown@example.com"
    }
  }
}
